APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (verifikasi bot di halaman registrasi)
# Daftar di dash.cloudflare.com > Turnstile > Add site untuk dapat key.
# Kalau kosong dan APP_ENV=local, verifikasi dilewati otomatis.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# BILLING — Pembayaran Upgrade Plan Platform
# -----------------------------------------------------------------------------
# Mode pembayaran ditentukan OTOMATIS dari status Payment Gateway:
#   - Ada PG aktif (is_active=true)  ? mode otomatis (redirect ke PG)
#   - Semua PG nonaktif              ? mode manual (instruksi transfer)
#
# Isi semua variabel di bawah agar mode manual bisa berfungsi dengan benar.
# -----------------------------------------------------------------------------

# Kontak admin yang menerima konfirmasi pembayaran manual
BILLING_WHATSAPP=6281234567890
BILLING_EMAIL=admin@example.com

# Rekening bank untuk transfer manual
BILLING_BANK_NAME=BCA
BILLING_BANK_ACCOUNT=1234567890
BILLING_BANK_HOLDER=PT Nama Perusahaan

# Template pesan WhatsApp saat user klik tombol "Hubungi Admin"
# {order_ref} diganti kode referensi order secara otomatis
BILLING_WHATSAPP_TEMPLATE="Halo, saya ingin upgrade plan SIM-KASIR. Kode order saya: {order_ref}"
